# ---------------------------------------------------------------------------
# Variables d'environnement Supabase
# ---------------------------------------------------------------------------
# Copie ce fichier en `.env.local` (jamais versionné) et remplis les valeurs.
# Tu trouves ces 3 valeurs dans Supabase : Project Settings > API.
# ---------------------------------------------------------------------------

# URL du projet (ex: https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (sans danger côté navigateur, protégée par la RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" — SECRÈTE, serveur uniquement, contourne la RLS.
# Ne jamais l'exposer côté client ni la committer.
SUPABASE_SERVICE_ROLE_KEY=
